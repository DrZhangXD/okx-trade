# ============================================================
# OKX API 凭证（在 OKX 账户中心 → API 管理创建）
# 模拟盘的 API Key 需要在【模拟交易】区域单独创建
# ⚠️ 切勿提交真实凭证到 git！.env 已在 .gitignore 中
# ============================================================
OKX_API_KEY=your-api-key-here
OKX_SECRET_KEY=your-secret-key-here
OKX_PASSPHRASE=your-passphrase-here

# ============================================================
# 运行模式
# ============================================================
# true = 模拟盘（demo trading）, false = 实盘
OKX_IS_DEMO=true

# ============================================================
# 网络（国内访问 OKX 需要代理）
# ============================================================
# 例如本地 Clash/V2Ray HTTP 代理：http://127.0.0.1:7890
OKX_HTTP_PROXY=
OKX_HTTPS_PROXY=

# ============================================================
# REST 行为
# ============================================================
OKX_REQUEST_TIMEOUT_SEC=10.0
OKX_MAX_RETRIES=3

# 自定义 endpoint（留空走默认值；按 is_demo 自动选 demo/live URL）
OKX_REST_BASE_URL=
OKX_WS_PUBLIC_URL=
OKX_WS_PRIVATE_URL=
OKX_WS_BUSINESS_URL=

# ============================================================
# 日志
# ============================================================
OKX_LOG_LEVEL=INFO
